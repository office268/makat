# ─── בסיס נתונים ─────────────────────────────────────────────────────────
# בפיתוח מקומי אפשר להשאיר הכל ריק - ייווצר SQLite ב-instance/makat.db

# Railway מזריק את זה אוטומטית כשמוסיפים שירות Postgres לפרויקט.
# האפליקציה מזהה ומתרגמת אותו לבד - אין מה להגדיר ידנית.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# חלופה ל-Postgres: SQLite על ווליום קבוע.
# מצרפים Volume ב-Railway, ממפים ל-/data, ומגדירים:
# DATA_DIR=/data

# ─── חובה בפרודקשן ───────────────────────────────────────────────────────
# חותם את קוקי הסשן. האפליקציה מסרבת לעלות על Railway בלי ערך אמיתי.
# לייצור ערך:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ─── מנהל מערכת ──────────────────────────────────────────────────────────
# כתובות (מופרדות בפסיק) שמקבלות גישה למסכי ניהול חוצי-ארגונים, בראשם
# ייבוא קטלוג דגמי הרכב ב-/admin/vehicle-import. ההרשאה נשלטת מכאן בלבד -
# אי אפשר להעניק אותה מתוך היישום.
#
# זה משתנה הסביבה היחיד שקשור להרשאות. *מי מורשה להיכנס* אינו נמצא כאן
# אלא בטבלת המשתמשים, ומנהלים אותו מ-/team: ההזדהות היא מספר טלפון,
# ורשימת המספרים היא נתון שמשתנה ולא הגדרה של הסביבה.
# SUPERADMIN_EMAILS=office@make-i-tec.com

# ─── מתג חירום ────────────────────────────────────────────────────────────
# חוסם כל שינוי נתונים, גם למי שההרשאות מתירות לו. כבוי כברירת מחדל -
# ההגנה היומיומית היא מערכת ההרשאות (role_required על כל נקודת קצה
# שמשנה נתונים). הדלק רק כדי להקפיא כתיבה כשמשהו השתבש.
# READ_ONLY=1

# ─── אופציונלי ───────────────────────────────────────────────────────────
PER_PAGE=25
# מאגרי כלי הרכב שנשאלים. ברירת המחדל כבר כוללת שלושה: הרכב הפרטי
# והמסחרי, ה"המשך" שלו (המרשם מפוצל לשניים - וזו הייתה הסיבה שרכב
# אמיתי החזיר "לא נמצא"), והרכבים שירדו מהכביש. "מזהה:תווית", בפסיקים.
# GOV_VEHICLE_RESOURCES=<id>:תווית,<id>:תווית
# GOV_LOOKUP_BUDGET=20    # תקציב זמן לכל החיפוש, בשניות
# GOV_API_TIMEOUT=6       # תקציב לבקשה בודדת
# את המזהים לא צריך לנחש - "plate_probe.py <רישוי> --discover" מוצא
# אותם ומדפיס את השורה המוכנה להדבקה.
# GOV_DISCOVER_QUERY=כלי רכב        # מה מחפשים כשמאתרים מאגרים
# GOV_DISCOVER_ROWS=30
# כמה עמודים (1000 רשומות כל אחד) לייבא בבקשה אחת, ותקציב הזמן שלה
# בשניות. חייב להישאר בבטחה מתחת ל-WEB_TIMEOUT.
# VEHICLE_IMPORT_PAGES_PER_CHUNK=3
# VEHICLE_IMPORT_TIME_BUDGET=25
# טוען מק"טים מקובץ CSV בכל דיפלוי. בטוח להרצה חוזרת - מק"ט קיים
# מעודכן ולא משוכפל. data/parts_catalog.csv הוא הקטלוג שנאסף עד היום.
# IMPORT_PARTS_CSV=data/parts_catalog.csv
# WEB_CONCURRENCY=2    # מספר workers של gunicorn
# WEB_THREADS=4
# WEB_TIMEOUT=60
# LOG_LEVEL=info

# ─── לוג השימוש ──────────────────────────────────────────────────────────
# שורה לכל בקשה משמעותית, לצפייה ב-/activity. ערכי שדות של טפסים אינם
# נשמרים - רק שמות השדות, ובלי השדות הרגישים.
# ACTIVITY_LOG_ENABLED=1        # 0 מכבה לגמרי את הכתיבה
# ACTIVITY_LOG_RETENTION_DAYS=90  # מה ש-"flask prune-activity" מוחק
# ACTIVITY_PER_PAGE=50
# DISPLAY_TIMEZONE=Asia/Jerusalem  # אזור הזמן להצגת הזמנים במסכים

# מפעיל שלושה דברים: זיהוי חלק מתמונה, גילוי מק"טים מהאינטרנט
# ב-/admin/discovery, והשליפה החיה לפי מספר שלדה. בלעדיו הזיהוי
# מטקסט והחיפוש בקטלוג עובדים כרגיל.
# ANTHROPIC_API_KEY=sk-ant-...
# WEB_SEARCH_TOOL=web_search_20250305   # גרסת כלי חיפוש הרשת של Anthropic
# DISCOVERY_MAX_SEARCHES=6              # חיפושים לכל מטרה

# ─── שליפה חיה לפי מספר שלדה ─────────────────────────────────────────────
# מה שאין בקטלוג נשלף מקטלוג היצרן לפי השלדה, ומשם למק"טים חלופיים.
# הסדר הוא המהות: epc מייצר את מספר ה-OE ש-aftermarket מחפש לפיו.
# mock הוא מקור מדומה בלי רשת ובלי מפתח - שימושי לפיתוח התצוגה.
#
# ברירת המחדל הייתה laximo,tecdoc ושונתה: כתובת ברירת המחדל של Laximo
# היא השערה ש-laximo.ru מחזיר עליה 404, כלומר השרשרת הקודמת לא יכלה
# לענות - וכיבתה את epc, המקור היחיד שנבדק מול האתר החי ומחזיר מק"טים.
# laximo ו-tecdoc נשארים זמינים למי שיש לו חשבון מולם.
# CATALOG_SOURCES=epc,aftermarket
#
# ─── Laximo: שלדה -> מק"ט מקורי ─────────────────────────────────────────
# עם login/password רץ ה-API הרשמי; בלעדיהם - הקטלוג בדפדפן.
# LAXIMO_LOGIN=
# LAXIMO_PASSWORD=
# LAXIMO_MODE=auto                # auto | api | web
# LAXIMO_API_URL=https://ws.laximo.ru/ec.api.php
# מחרוזת הפקודה משתנה בין חבילות רישיון - לפי התיעוד של החשבון שלך.
# LAXIMO_VIN_COMMAND=FindVehicleByVIN:Locale=en_US|vin={vin}|localized=true
# חובה כדי שהשליפה החיה תעבוד: ברירת המחדל שבקוד היא השערה,
# ו-laximo.ru מחזיר עליה 404. הגדר כאן כתובת חיפוש אמיתית.
# LAXIMO_WEB_URL=https://laximo.ru/search?type=vin&q={vin}
# LAXIMO_WEB_WAIT=                # סלקטור שמסמן שהתוצאה נטענה
# כשהחיפוש הוא טופס ולא כתובת: השדה שממלאים והכפתור שלוחצים
# LAXIMO_WEB_INPUT=input[name="vin"]
# LAXIMO_WEB_SUBMIT=button[type="submit"]
#
# ─── TecDoc: מק"ט מקורי -> חלופים ────────────────────────────────────────
# עם api_key ומזהה ספק רץ השירות הרשמי של TecAlliance.
# TECDOC_API_KEY=
# TECDOC_PROVIDER=
# TECDOC_MODE=auto                # auto | api | web
# TECDOC_COUNTRY=IL
# TECDOC_LANG=en
# TECDOC_QUERY=                   # תבנית גוף בקשה משלך, עם {oem}
# TECDOC_WEB_URL=https://webcat.tecalliance.services/search?query={oem}
# TECDOC_WEB_WAIT=                # סלקטור שמסמן שהתוצאה נטענה
# TECDOC_WEB_INPUT=
# TECDOC_WEB_SUBMIT=
# TECDOC_MAX_NUMBERS=2            # כמה מספרי OE נבדקים בשליפה אחת
#
# ─── מי מביא את הדף ──────────────────────────────────────────────────────
# auto בוחר את הטוב ביותר שזמין: ScraperAPI -> דפדפן מקומי -> urllib.
# CATALOG_FETCHER=auto            # auto | scraperapi | browser | direct
#
# ScraperAPI: עוקף חסימת IP של ענן, ומריץ את ה-JavaScript בצד שלהם -
# כלומר מייתר את Chromium בתמונה. די במפתח כדי ש-auto יבחר בו.
# SCRAPERAPI_KEY=
# SCRAPERAPI_RENDER=1             # 0 מבטל הרצת JS (זול יותר, מהיר יותר)
# SCRAPERAPI_COUNTRY=il           # מאיפה נראה שהגענו - משפיע על מחירים
# SCRAPERAPI_PREMIUM=0            # פרוקסי מגורים. עולה יותר, עובר איפה שנחסם
#                                 # זה הלבן כשאתר מאחורי Cloudflare מחזיר 403
# SCRAPERAPI_TIMEOUT=40
#
# ⚠ עם render=true העיבוד לוקח עשרות שניות, ובקשת שלב אחת היא הבאה
#   ועוד קריאה למודל. לכן צריך להעלות את תקציב הזמן של gunicorn:
# WEB_TIMEOUT=90
#
#   שלושת המספרים חייבים להסתדר יחד:
#     SCRAPERAPI_TIMEOUT + CATALOG_MODEL_BUDGET  <  WEB_TIMEOUT
#   אחרת gunicorn הורג את העובד באמצע ההבאה, והמשתמש לא מקבל אפילו
#   הודעת שגיאה. הקוד מזהה הגדרה כזו ומזהיר עליה ביומן.
#   נבדק בשטח: PartSouq עם render=true לא סיים ב-40 שניות.
#   צירוף שעובד: WEB_TIMEOUT=120, SCRAPERAPI_TIMEOUT=90.
# CATALOG_MODEL_BUDGET=15         # כמה להשאיר לקריאת המודל שאחרי ההבאה
#
# ─── דפדפן (Playwright), למסלול ה-web ────────────────────────────────────
# בלי חשבון API זה המסלול היחיד. הספרייה ב-requirements.txt, אבל את
# הדפדפן עצמו צריך להוריד בשלב הבנייה:
#   playwright install --with-deps chromium
# CATALOG_BROWSER=1               # 0 מכבה את מסלול הדפדפן לגמרי
# CATALOG_BROWSER_TIMEOUT=20      # חייב להישאר מתחת ל-WEB_TIMEOUT
# CATALOG_BROWSER_WAIT=networkidle
# CATALOG_BROWSER_LOCALE=he-IL
# CATALOG_BROWSER_UA=             # דף שמוגש ל-HeadlessChrome אינו הדף שצריך
# CATALOG_CONSENT_SELECTORS=      # כפתורי "אני מסכים" לסגירה, מופרדים בפסיק
# PLAYWRIGHT_CHROMIUM_PATH=       # כשגרסת ה-build של Playwright והתמונה שונות
# קובץ עוגיות לקטלוג שדורש כניסה. נוצר פעם אחת ונשמר.
# CATALOG_STORAGE_STATE=/data/laximo-session.json
#
# ─── מקורות גנריים (חלופה לאתר אחר) ──────────────────────────────────────
# כתובת חיפוש השלדה. אפשר כמה מופרדות ב-"|", והן ינוסו לפי הסדר עד
# שאחת עונה — כך ריצה אחת בודקת כמה מועמדות, והיומן אומר איזו עבדה.
# חובה שתישא את {vin}, אחרת אין בה שום דבר שמזהה את הרכב.
#
# ברירת המחדל נבדקה מול האתר החי ועובדת (שלדת טויוטה -> עמוד קטלוג
# מזוהה עם קבוצות ותרשימים). קטלוגי PartSouq: טויוטה, לקסוס, ניסאן,
# אינפיניטי, מיצובישי, סובארו, יונדאי, קיה, סוזוקי, מאזדה, הונדה,
# איסוזו, רנו, וולוו, קרייזלר, ג'יפ, דודג', רם. אין שם פיג'ו,
# סיטרואן, סקודה ופולקסווגן.
# EPC_VIN_URL=https://partsouq.com/en/search/all?q={vin}
#
# ‏7zap נבדק ואינו מתאים משלוש סיבות: /en/search/?q={vin} אינו קיים
# שם (מחזיר 200 ומקפיץ לדף הבית), התרשימים ומספרי החלקים שלו נעולים
# מאחורי מנוי - הגרסה החינמית מחזירה יצרן, דגם ושנה בלבד - ו-robots.txt
# שלו אוסר את הנתיב, כלומר ההבאה נחסמת אצלנו עוד לפני הבקשה.
#
# מגבלה שכדאי לדעת עליה לפני שמאשימים את הכתובת: PartSouq מודיע בעצמו
# ש"VIN decoding is temporarily supported for Toyota only". שלדת קיה
# או סקודה תחזיר שם "Nothing found" - זו אינה תקלה אלא הכיסוי. שאר
# הקטלוגים שלו נפתחים דרך בחירת דגם ידנית, בכתובת שנושאת אסימון ssd
# זמני, ולכן אי אפשר להגיע אליהם מתבנית כתובת קבועה.
#
# ─── שלב שני: מק"ט מקורי -> חלופים ─────────────────────────────────────
# ברירת המחדל הייתה autodoc.co.il, ולדומיין הזה אין רשומת DNS כלל -
# AUTODOC אינה פועלת בישראל, וכל שליפה מתה ב-Name or service not known.
# alvadi.co.il נבדק מול האתר החי: מק"ט מקורי מחזיר את החלק המקורי
# ולצידו עשרות חלופים עם יצרן ומחיר בשקלים, ו-robots.txt מתיר.
# AFTERMARKET_URL=https://alvadi.co.il/en/search?q={oem}
# EPC_MAX_HOPS=4                  # כמה עמודים מותר לעקוב אחרי חיפוש השלדה
#                                 # קטלוג יצרן הוא עץ: רכב -> קבוצה ->
#                                 # תרשים -> מק"טים. שניים לא הספיקו.
#                                 # בקטלוג טויוטה הקיצור ב-toyota_groups
#                                 # מדלג על שני צעדי הביניים, ואז די בשניים.
# LOOKUP_STEP_BUDGET=             # שניות לבקשת שלב; ריק = נגזר מ-WEB_TIMEOUT
# AFTERMARKET_MAX_NUMBERS=2       # כמה מספרי OE נבדקים בשליפה אחת
#
# CATALOG_PARSE_MODEL=claude-opus-5
# CATALOG_USER_AGENT=makat/1.0 (+https://github.com/office268/makat)
# CATALOG_FETCH_TIMEOUT=12
# CATALOG_HOST_PAUSE=1.0          # נשימה בין בקשות לאותו מארח
# CATALOG_RESPECT_ROBOTS=1        # 0 מדלג על בדיקת robots.txt
# CATALOG_MAX_CONDENSED=30000     # כמה תווים מהדף נשלחים למודל
# CATALOG_MIN_TEXT=200           # מתחת לזה הדף נחשב שלד ריק של JavaScript
#
# LOOKUP_CACHE_DAYS=60            # כמה זמן תשובה שמורה נחשבת טרייה
# LOOKUP_DAILY_LIMIT=50           # תקרת שליפות חיות לארגון ליממה
#
# ─── יומן החקירה ─────────────────────────────────────────────────────────
# מה שמופיע במסך תחת "פרטי החיפוש": איזו כתובת נפתחה, לאן הופנינו,
# מה נשלח למודל ומה הוא ענה. זה מה שמבדיל בין "האתר לא ענה", "הופנינו
# לדף הבית" ו"החלק לא קיים לרכב הזה" - שלושתן נראות אחרת רק כאן.
# CATALOG_TRACE=1                 # 0 מכבה את היומן לגמרי
# CATALOG_TRACE_LINES=200         # תקרת שורות לשלב
# CATALOG_TRACE_PREVIEW=400       # כמה מהטקסט שנשלח למודל נכנס ליומן
# LOOKUP_LOG_CHARS=24000          # כמה מהיומן נשמר בעבודה
# LOOKUP_LOG_LINES=200            # כמה שורות עולות למסך
