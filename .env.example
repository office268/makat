# בפיתוח מקומי אפשר להשאיר ריק - ייווצר SQLite ב-instance/

# Railway מזריק את זה אוטומטית כשמוסיפים שירות Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# חלופה: SQLite על ווליום קבוע (למקרה שלא רוצים Postgres)
# DATA_DIR=/data

SECRET_KEY=change-me-in-production
PER_PAGE=25

