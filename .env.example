# ─── בסיס נתונים ─────────────────────────────────────────────────────────
# בפיתוח מקומי אפשר להשאיר הכל ריק - ייווצר SQLite ב-instance/makat.db

# Railway מזריק את זה אוטומטית כשמוסיפים שירות Postgres לפרויקט.
# האפליקציה מזהה ומתרגמת אותו לבד - אין מה להגדיר ידנית.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# חלופה ל-Postgres: SQLite על ווליום קבוע.
# מצרפים Volume ב-Railway, ממפים ל-/data, ומגדירים:
# DATA_DIR=/data

# ─── חובה בפרודקשן ───────────────────────────────────────────────────────
# חותם את קוקי הסשן. האפליקציה מסרבת לעלות על Railway בלי ערך אמיתי.
# לייצור ערך:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ─── מנהל מערכת ──────────────────────────────────────────────────────────
# כתובות (מופרדות בפסיק) שמקבלות גישה למסכי ניהול חוצי-ארגונים, בראשם
# ייבוא קטלוג דגמי הרכב ב-/admin/vehicle-import. ההרשאה נשלטת מכאן בלבד -
# אי אפשר להעניק אותה מתוך היישום.
# SUPERADMIN_EMAILS=you@example.com

# ─── אופציונלי ───────────────────────────────────────────────────────────
PER_PAGE=25
# כמה עמודים (1000 רשומות כל אחד) לייבא בבקשה אחת, ותקציב הזמן שלה
# בשניות. חייב להישאר בבטחה מתחת ל-WEB_TIMEOUT.
# VEHICLE_IMPORT_PAGES_PER_CHUNK=3
# VEHICLE_IMPORT_TIME_BUDGET=25
# טוען מק"טים מקובץ CSV בכל דיפלוי. בטוח להרצה חוזרת - מק"ט קיים
# מעודכן ולא משוכפל. data/parts_catalog.csv הוא הקטלוג שנאסף עד היום.
# IMPORT_PARTS_CSV=data/parts_catalog.csv
# WEB_CONCURRENCY=2    # מספר workers של gunicorn
# WEB_THREADS=4
# WEB_TIMEOUT=60
# LOG_LEVEL=info

# ─── לוג השימוש ──────────────────────────────────────────────────────────
# שורה לכל בקשה משמעותית, לצפייה ב-/activity. ערכי שדות של טפסים אינם
# נשמרים - רק שמות השדות, ובלי השדות הרגישים.
# ACTIVITY_LOG_ENABLED=1        # 0 מכבה לגמרי את הכתיבה
# ACTIVITY_LOG_RETENTION_DAYS=90  # מה ש-"flask prune-activity" מוחק
# ACTIVITY_PER_PAGE=50
# DISPLAY_TIMEZONE=Asia/Jerusalem  # אזור הזמן להצגת הזמנים במסכים

# מפעיל שני דברים: זיהוי חלק מתמונה, וגילוי מק"טים מהאינטרנט
# ב-/admin/discovery. בלעדיו הזיהוי מטקסט עובד כרגיל.
# ANTHROPIC_API_KEY=sk-ant-...
# WEB_SEARCH_TOOL=web_search_20250305   # גרסת כלי חיפוש הרשת של Anthropic
# DISCOVERY_MAX_SEARCHES=6              # חיפושים לכל מטרה

# ─── דוא"ל ───────────────────────────────────────────────────────────────
# בלי ההגדרות האלה ההזמנות עדיין נוצרות, אבל הקישור מוצג להעתקה ידנית
# במקום להישלח. המסך אומר את זה במפורש.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=app-password
# MAIL_SENDER=noreply@example.com
# MAIL_SENDER_NAME=קטלוג מק"טים
